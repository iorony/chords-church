NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Failover de IA. Se prueban de izquierda a derecha y se omiten los que no tengan API key.
# Recomendado: Groq primero por velocidad, OpenRouter después por variedad gratuita.
AI_PROVIDER_ORDER=groq,openrouter
AI_TIMEOUT_MS=30000
# Reintentos antes de pasar al siguiente proveedor (0-2). Por defecto es 1
# aunque quites esta línea; ponlo en 0 explícitamente para desactivarlo.
AI_MAX_RETRIES=0

# Groq: rápido. Obtén la clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter: usa automáticamente un modelo gratuito disponible.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=Church Chords

# Gemini es opcional. Si tu proyecto de Google no tiene acceso, déjalo vacío.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Proveedores opcionales de pago o con crédito promocional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Kie.ai (opcional). Cambia la URL si eliges otro modelo de chat compatible.
KIE_API_KEY=
KIE_MODEL=gemini-3-pro
KIE_API_URL=https://api.kie.ai/gemini-3-pro/v1/chat/completions

# Compatibilidad anterior: si AI_PROVIDER_ORDER no existe, se lee AI_PROVIDER.
# AI_PROVIDER=openrouter

# Búsqueda web externa (opcional, ver lib/services/external-search-service.ts)
SEARCH_PROVIDER=
SEARCH_API_KEY=

EXPORT_STORAGE_BUCKET=exports
CRON_SECRET=change-me
